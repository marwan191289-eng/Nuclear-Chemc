# GEMINI_API_KEY: مفتاح الذكاء الاصطناعي لتوليد خطط المذاكرة وتقييم تحديد المستوى
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: نص سري طويل (32 حرفاً أو أكثر) لتوقيع وحماية جلسات تسجيل الدخول والكوكيز
SESSION_SECRET="nuclear-knowledge-hub-session-secret-key-2026-secure-hmac"

# VITE_PUBLIC_SITE_URL: رابط موقعك الأساسي على الإنترنت (يُستخدم في روابط الـ SEO وملف sitemap.xml وصورة المشاركة)
VITE_PUBLIC_SITE_URL="https://nuclear-knowledge-hub.vercel.app"

# ADMIN_PASSWORD: كلمة المرور الخاصة بدخول لوحة تحكم المهندس والأدمن
ADMIN_PASSWORD="mahmoud-nuclear-2026"
